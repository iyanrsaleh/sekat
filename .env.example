# Salin menjadi .env di server. Jangan unggah .env dari mesin lokal.
# APP_ENV=production mematikan debug.

APP_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=framework
DB_USER=framework
DB_PASS=

# IP proxy yang boleh dipercaya untuk X-Forwarded-Proto (HTTPS di belakang Nginx).
# Kosongkan bila TLS berakhir langsung di Apache/PHP.
TRUSTED_PROXIES=127.0.0.1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Sekat
MAIL_SECURE=tls

# Hanya bila seed dijalankan pada basis data kosong di produksi.
# Minimal 12 karakter. Sandi ini tidak dicetak.
SEED_ADMIN_PASSWORD=

# Dideklarasikan (boleh kosong) agar nilai .env aplikasi lain di Apache yang sama tidak terbaca.
MAIL_TIMEOUT=
AUTH_COOKIE_REFRESH=
NX_PROXY_UPSTREAMS=
FRAMEWORK_PUBLIC=
